import { readFile, writeFile } from 'node:fs/promises';
import { fileURLToPath } from 'node:url';
import { resolve } from 'node:path';
const root = fileURLToPath(new URL('../docs/visual-audit/samples/', import.meta.url));
const manifest = JSON.parse(await readFile(resolve(root, 'manifest.json'), 'utf8'));
const panels = manifest.entries.map((e: any) => `<article><h2>${e.name}</h2><div class="pair"><img src="${e.path}"><img class="dark" src="${e.path}"></div><p>原图 ${e.width}×${e.height} · ${(e.bytes/1024).toFixed(1)} KiB · 真透明 ${e.alphaVerified ? '已验证' : '失败'}</p><div class="variants">${e.variants.map((v: any) => `<figure><img src="${v.file}" style="width:${e.name.endsWith('display')?146:64}px"><figcaption>${v.size}px / ${(v.bytes/1024).toFixed(1)} KiB<br>RGBA ${(v.rgbaBytes/1024).toFixed(0)} KiB</figcaption></figure>`).join('')}</div></article>`).join('');
await writeFile(resolve(root, 'review.html'), `<!doctype html><html lang="zh-CN"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>代表样张 02</title><style>body{margin:32px;background:#f6f1e7;color:#263d38;font:16px system-ui}h1{margin-bottom:8px}p{line-height:1.7;max-width:1000px}main{display:grid;grid-template-columns:repeat(auto-fit,minmax(350px,1fr));gap:24px}article{padding:20px;border-radius:18px;background:white}.pair{display:flex;gap:12px}.pair img{width:46%;background:#fff5de;object-fit:contain}.pair .dark{background:#233a40}.variants{display:flex;align-items:end;flex-wrap:wrap}figure{margin:10px}figcaption{font-size:12px;margin-top:8px}canvas{max-width:100%;height:auto;border:1px solid #999}section{margin-top:30px}.controls{display:flex;gap:20px;flex-wrap:wrap}</style><h1>代表样张 02 · 苹果 / 兔子 / 蓝鸟</h1><p>已确认画风方向；本页为独立样张审查，未接入游戏。原图透明边缘置于浅/深底检查；PNG版本仅缩小与无损编码，没有低质量有损版本。请以完整战场和下面的小尺寸对照判断清晰度，不能只看放大图。</p><main>${panels}</main><section><h2>实际比例与 DPR 对照</h2><p>采用正式全宽视口 scale=高度/560。苹果普通帽标为34×40/64=21.25逻辑像素；兔/鸟暂以48逻辑像素外观框试制（待确认，碰撞未修改）。DPR只影响画布背板像素。下图为尺寸检测条，不是运行截图。各档图片置于相同显示大小。</p><div class="controls"><label>视口 <select id="view"><option value="620">手机 390×620</option><option value="580">平板 1024×580</option></select></label><label>DPR <select id="dpr"><option>1</option><option selected>2</option><option>3</option></select></label><label>底色 <select id="bg"><option value="#ede0bd">浅</option><option value="#233a40">深</option></select></label></div><canvas id="sizes"></canvas></section><section><h2>完整战场合成</h2><p>使用当前正式CanvasScene离屏绘制、以样张替换指定外观的审样夹具；固定排列、静态，不代表自然刷怪、设备截图或动画验收。手机/平板及低/高密度用于观察遮挡和画风协调，宠物不显示血条。</p><div id="scenes"></div></section><script>
const canvas=document.querySelector('#sizes');async function render(){const d=+document.querySelector('#dpr').value,s=+document.querySelector('#view').value/560;canvas.width=720*d;canvas.height=250*d;canvas.style.width='720px';const c=canvas.getContext('2d');c.scale(d,d);c.fillStyle=document.querySelector('#bg').value;c.fillRect(0,0,720,250);for(const [i,n]of ['apple','rabbit','bird'].entries()){for(const [j,size]of [64,128,256].entries()){const im=new Image();im.src='variants/'+n+'-battle-'+size+'.png';await im.decode();const w=(i===0?21.25:48)*s;c.drawImage(im,30+j*225,25+i*75,w,w);c.fillStyle=document.querySelector('#bg').value==='#233a40'?'white':'#263d38';c.font='13px system-ui';c.fillText(n+' '+size+'px',90+j*225,55+i*75)}}}document.querySelectorAll('select').forEach(e=>e.onchange=render);render();for(const n of ['phone-low','phone-high','ipad-low','ipad-high']){const f=document.createElement('figure');f.innerHTML='<figcaption>'+n+' · 离屏合成</figcaption><img style="max-width:100%" src="scenes/'+n+'.png">';document.querySelector('#scenes').append(f)}
</script></html>`);
