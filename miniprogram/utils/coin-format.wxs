// Truncate display fractions; wallet accounting always retains the exact integer.
function format(value) {
  var unit = value >= 1000000000000 ? 1000000000000 : value >= 100000000 ? 100000000 : value >= 10000 ? 10000 : 1;
  var suffix = unit === 1000000000000 ? '万亿' : unit === 100000000 ? '亿' : unit === 10000 ? '万' : '';
  return (Math.floor(value / unit * 100) / 100) + suffix;
}
module.exports = { format: format };
