:host { display: block; }
.listening { padding: 32rpx 16rpx 20rpx; color: #334c45; text-align: center; }
.sound-halo { display: flex; align-items: center; justify-content: center; gap: 6rpx; width: 112rpx; height: 112rpx; border-radius: 50%; margin: 0 auto 30rpx; background: #d8efcf; box-shadow: 0 0 0 16rpx #edf5e6; }
.speaker { width: 20rpx; height: 30rpx; background: #477449; border-radius: 4rpx; position: relative; }
.speaker::after { content: ''; position: absolute; top: -10rpx; right: -12rpx; border-top: 25rpx solid transparent; border-bottom: 25rpx solid transparent; border-right: 25rpx solid #477449; }
.sound-wave { width: 20rpx; height: 42rpx; margin-left: 16rpx; border-right: 5rpx solid #477449; border-radius: 50%; }
.speaking { animation: speak 1s ease-in-out infinite; }
@keyframes speak { 50% { box-shadow: 0 0 0 24rpx #edf5e6; } }
.prompt { font-size: 30rpx; font-weight: 600; min-height: 70rpx; }
.choices { display: flex; justify-content: center; gap: 16rpx; margin: 16rpx 0 32rpx; }
.choices .choice { flex: 1; min-width: 0; max-width: 184rpx; padding: 20rpx 8rpx; margin: 0; border: 5rpx solid #dfd5b7; border-radius: 24rpx; background: #fffef4; box-shadow: 0 8rpx 0 #e4d9bb; }
.choice::after { border: 0; }
.choice[disabled] { opacity: .72; }
.choice image { display: block; width: 100%; height: 146rpx; }
.choice.hinted { border-color: #84b948; box-shadow: 0 0 0 6rpx #d2e7ac; }
.replay { width: 220rpx; margin-top: 16rpx; border-radius: 40rpx; font-size: 26rpx; color: #49654a; background: #e7efda; }
.replay::after { border: 0; }
.error { padding: 32rpx; color: #75382c; text-align: center; }

.replay { min-width: 0; max-width: 220rpx; }

.listening { position: relative; }
.speed-control { position: absolute; top: 0; right: 10rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; width: 126rpx; height: 60rpx; padding: 0; margin: 0; border-radius: 30rpx; font-size: 24rpx; line-height: 1; color: #456346; background: #e7efda; }.speed-control::after { border: 0; }.speed-symbol { font-size: 32rpx; }

.fruit-english { display: block; margin-top: 10rpx; font-size: 26rpx; line-height: 1.4; font-weight: 700; overflow-wrap: break-word; }
.fruit-meaning { display: block; margin-top: 4rpx; font-size: 22rpx; line-height: 1.4; font-weight: normal; color: #64715d; }
.speed-control { min-width: 0; max-width: 126rpx; }
