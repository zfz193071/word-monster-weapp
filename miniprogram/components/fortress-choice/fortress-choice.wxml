<view wx:if="{{error}}" class="error">{{error}}</view>
<view wx:if="{{view}}" class="listening">
  <button class="speed-control" bindtap="changeSpeed" disabled="{{view.paused || view.phase === 'started' || view.phase === 'answered'}}" aria-label="播放速度 {{view.playbackRate}} 倍，点击切换"><view class="speed-symbol" aria-hidden="true">▷</view><text>{{view.playbackRate}}×</text></button>
  <view class="sound-halo {{view.phase === 'playing' && !view.paused ? 'speaking' : ''}}" aria-hidden="true"><view class="speaker"></view><view class="sound-wave"></view></view>
  <view class="prompt" aria-live="polite">{{view.message}}</view>
  <view wx:if="{{request.singleAttempt && view.phase !== 'answered'}}" class="quiz-caption">首次答对最多选2个技能，答错选1个</view>
  <view class="choices">
    <button wx:for="{{view.cards}}" wx:key="key" class="choice {{item.hinted ? 'hinted' : ''}}" aria-label="{{item.label}}" disabled="{{!view.canChoose}}"
      data-token="{{view.token}}" data-word-id="{{item.id}}" bindtap="choose">
      <image src="{{item.portraitPath}}" mode="aspectFit" aria-hidden="true" data-token="{{view.imageToken}}" data-word-id="{{item.id}}" bindload="imageLoaded" binderror="imageFailed" />
      <text class="fruit-english">{{item.text}}</text>
      <text class="fruit-meaning">{{item.meaningZh}}</text>
    </button>
  </view>
  <view wx:if="{{view.phase === 'answered'}}" class="answer-result" aria-live="polite">{{view.answerText}}</view>
  <button wx:if="{{view.phase === 'answered'}}" class="replay quiz-continue" disabled="{{view.paused}}" data-token="{{view.token}}" bindtap="continueQuiz">去选技能</button>
  <button wx:elif="{{view.phase === 'audioError'}}" class="replay" disabled="{{view.paused}}" data-token="{{view.token}}" bindtap="retryAudio">重试声音</button>
  <button wx:else class="replay" disabled="{{view.paused || view.phase === 'started' || view.phase === 'answered'}}" data-token="{{view.token}}" bindtap="replay" aria-label="再听一次">再听一次</button>
  <button wx:if="{{view.imageFailed}}" class="replay" disabled="{{view.paused}}" data-token="{{view.imageToken}}" bindtap="retryImages">重试图片</button>
</view>
