:host { display:block; width:100%; max-width:680rpx; }
.difficulty-panel { position:relative; box-sizing:border-box; width:100%; padding:36rpx 28rpx 28rpx; border:6rpx solid #fff9e4; border-radius:40rpx; background:#fff8e7; box-shadow:0 16rpx 0 #243d3d33; }
.title { display:block; color:#456452; font-size:36rpx; font-weight:bold; text-align:center; margin-bottom:32rpx; }
.close { position:absolute; top:8rpx; right:12rpx; width:64rpx; min-width:0; max-width:64rpx; height:64rpx; padding:0; background:transparent; color:#7c826c; font-size:48rpx; line-height:60rpx; }
button::after { border:0; }
.choices { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20rpx; }
.choice { box-sizing:border-box; display:flex; flex-direction:column; align-items:center; width:100%; min-width:0; max-width:none; margin:0; padding:24rpx 12rpx 18rpx; border:4rpx solid #eadfc7; border-radius:28rpx; background:#fffdf5; line-height:1.3; }
.choice.selected { border-color:#6c9851; background:#edf5df; box-shadow:0 4rpx 0 #6c9851; }
.label { margin-top:14rpx; color:#49614b; font-size:30rpx; font-weight:bold; }
.selection-dot { width:12rpx; height:12rpx; border-radius:50%; background:#e0d9c8; margin-top:12rpx; }.selected .selection-dot { background:#6c9851; }
.error { display:block; text-align:center; color:#a34840; font-size:24rpx; margin-top:24rpx; }

.caption { display:block; margin-top:24rpx; text-align:center; color:#7b826f; font-size:23rpx; }
