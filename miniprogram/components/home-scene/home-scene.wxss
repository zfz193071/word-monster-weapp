:host { display: block; width: 100%; height: 100%; }
.room-stage { position: relative; width: 100%; height: 100%; }
.room-canvas,.room-frozen { position: absolute; inset: 0; width: 100%; height: 100%; }
.room-retry { position: absolute; top: 45%; left: 20%; width: 60%; min-width: 0; border-radius: 36rpx; background: #ecedcc; color: #556c4e; font-size: 26rpx; }
