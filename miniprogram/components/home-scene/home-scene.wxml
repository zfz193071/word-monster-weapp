<view class="room-stage">
  <image wx:if="{{covered && frozenFrame}}" class="room-frozen" src="{{frozenFrame}}" mode="scaleToFill" />
  <canvas type="2d" id="room-canvas" class="room-canvas" catchtouchstart="touchStart" catchtouchmove="touchMove" catchtouchend="touchEnd" catchtouchcancel="touchCancel" catchtap="stopTap" wx:if="{{!covered}}" />
  <button wx:if="{{error}}" class="room-retry" bindtap="retry">重新加载场景</button>
</view>
