<view wx:if="{{offer && valid}}" class="skill-overlay" catchtouchmove="stopScroll" role="dialog" aria-label="选择升级技能">
  <view wx:if="{{remaining}}" class="pick-count" aria-live="polite">{{quizIncorrect ? '选1个技能' : '选' + (showGuide ? 2 : remaining) + '个技能'}}</view>
  <view class="skill-cards">
    <button wx:for="{{displayCards}}" wx:key="id" class="skill-card card-{{item.icon}} quality-{{item.resultingQuality}} {{item.chosen ? 'card-chosen' : ''}}" disabled="{{disabled || item.chosen || selectedOfferId === offer.id}}" data-offer-id="{{offer.id}}" data-card-id="{{item.id}}" bindtap="choose">
      <view class="card-top">{{item.label}}</view>
      <view wx:if="{{item.qualityLabel}}" class="quality-badge">{{item.qualityLabel}} · Lv.{{item.skillLevel}}</view>
      <view class="skill-icon {{item.icon}}" aria-hidden="true"><view></view><view></view><view></view></view>
      <view class="card-detail">{{item.shortDescription}}</view>
      <view wx:if="{{item.summon}}" class="combo-hint">最多3种召唤 · 全体3名
每20秒检查；满员，空位后自动补充</view>
      <view wx:if="{{item.comboHint}}" class="combo-hint">{{item.comboHint}}</view>
      <view wx:if="{{showGuide && !item.chosen && item.id === guideCardId}}" class="skill-guide {{disabled ? 'guide-paused' : ''}}" aria-label="再选择一个技能">👆</view>
      <view class="card-select" aria-hidden="true">{{item.chosen ? '已选择 ✓' : '＋'}}</view>
    </button>
  </view>
</view>
