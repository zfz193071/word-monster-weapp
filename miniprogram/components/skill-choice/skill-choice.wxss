.skill-overlay { position: fixed; inset: 0; z-index: 20; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 24rpx; background: #142b2bde; box-sizing: border-box; }
.upgrade-badge { font-size: 26rpx; letter-spacing: 5rpx; color: #c9dc96; margin-bottom: 16rpx; }.skill-title { font-size: 48rpx; font-weight: 800; color: #fff7d9; margin-bottom: 64rpx; }
.skill-cards { display: flex; gap: 16rpx; width: 100%; max-width: 900rpx; }.skill-card { flex: 1; min-width: 0; padding: 0 0 24rpx; margin: 0; border: 5rpx solid #f2d9a5; border-radius: 22rpx; background: #fff7df; color: #3e4d39; box-shadow: 0 10rpx 0 #071c1c66; }.skill-card::after { border: 0; }
.card-top { padding: 20rpx 4rpx; font-size: 28rpx; font-weight: 700; background: #778d53; color: #fff7df; line-height: 1.5; }.skill-icon { display: flex; align-items: center; justify-content: center; gap: 8rpx; width: 120rpx; height: 120rpx; margin: 32rpx auto; border-radius: 50%; background: #e6edce; }.skill-icon view { width: 16rpx; height: 55rpx; border-radius: 10rpx 10rpx 4rpx 4rpx; background: #dcad4b; border-bottom: 8rpx solid #9c7039; }.doubleShot view:last-child { display: none; }.fireRate view { transform: rotate(25deg); }.fireRate view:nth-child(2) { height: 72rpx; }.bulletWidth view { display: none; }.bulletWidth view:first-child { display: block; width: 42rpx; }
.card-detail { min-height: 120rpx; padding: 0 14rpx; font-size: 25rpx; line-height: 1.6; }.card-select { width: 60rpx; height: 60rpx; border-radius: 50%; margin: 24rpx auto 0; color: #6c8946; background: #e6edce; font-size: 40rpx; line-height: 55rpx; }
