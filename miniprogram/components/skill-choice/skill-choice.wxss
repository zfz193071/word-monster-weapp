.skill-overlay { position: fixed; inset: 0; z-index: 100; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 24rpx; background: #142b2b55; box-sizing: border-box; }
.skill-cards { display: flex; gap: 16rpx; width: 100%; max-width: 900rpx; }.skill-card { flex: 1; min-width: 0; padding: 0 0 24rpx; margin: 0; border: 5rpx solid #f2d9a5; border-radius: 22rpx; background: #fff7df; color: #3e4d39; box-shadow: 0 10rpx 0 #071c1c66; }.skill-card::after { border: 0; }
.card-top { padding: 20rpx 4rpx; font-size: 28rpx; font-weight: 700; background: #778d53; color: #fff7df; line-height: 1.5; }.skill-icon { display: flex; align-items: center; justify-content: center; gap: 8rpx; width: 120rpx; height: 120rpx; margin: 32rpx auto; border-radius: 50%; background: #e6edce; }.skill-icon view { width: 16rpx; height: 55rpx; border-radius: 10rpx 10rpx 4rpx 4rpx; background: #dcad4b; border-bottom: 8rpx solid #9c7039; }.doubleShot view:last-child { display: none; }.fireRate view { transform: rotate(25deg); }.fireRate view:nth-child(2) { height: 72rpx; }.bulletWidth view { display: none; }.bulletWidth view:first-child { display: block; width: 42rpx; }
.card-detail { min-height: 120rpx; padding: 0 14rpx; font-size: 25rpx; line-height: 1.6; }.card-select { width: 60rpx; height: 60rpx; border-radius: 50%; margin: 24rpx auto 0; color: #6c8946; background: #e6edce; font-size: 40rpx; line-height: 55rpx; }

.skill-card { border-width: 3rpx; background: linear-gradient(155deg, #fff9e9, #e8e9cd); overflow: hidden; animation: card-arrive 400ms ease-out both; }.skill-card:nth-child(2) { animation-delay: 90ms; }.skill-card:nth-child(3) { animation-delay: 180ms; }
.card-kicker { padding-top: 16rpx; font-size: 18rpx; letter-spacing: 2rpx; color: #657d66; }.card-top { padding: 12rpx 4rpx; background: transparent; color: #304940; font-size: 26rpx; }.skill-icon { margin: 20rpx auto; width: 112rpx; height: 112rpx; box-shadow: inset 0 0 0 2rpx #fff9; }.card-detail { font-size: 23rpx; line-height: 1.65; min-height: 180rpx; }.card-select { margin-top: 12rpx; }
.card-flame { border-color: #edb478; background: linear-gradient(155deg, #fff2d8, #f2cfb5); }.card-frost { border-color: #97d8df; background: linear-gradient(155deg, #effbfa, #bfdfdf); }.card-lightning { border-color: #b8ace9; background: linear-gradient(155deg, #f6f0ff, #d4c9ea); }
.flame { background: #efb984; }.flame view { position: absolute; width: 46rpx; height: 68rpx; border: 0; border-radius: 70% 15% 65% 45%; transform: rotate(-20deg); background: #e77842; animation: flame-breathe 1200ms ease-in-out infinite; }.flame view:nth-child(2) { width: 26rpx; height: 44rpx; margin-top: 20rpx; background: #ffe9a0; }.flame view:last-child { display: none; }
.frost { background: #91cbd3; }.frost view { position: absolute; width: 8rpx; height: 76rpx; background: #f3ffff; border: 0; border-radius: 3rpx; box-shadow: 0 0 8rpx #d7fcff; }.frost view:nth-child(2) { transform: rotate(60deg); }.frost view:nth-child(3) { transform: rotate(-60deg); }
.lightning { background: #a49bd1; }.lightning view { position: absolute; width: 20rpx; height: 38rpx; border: 0; border-radius: 2rpx; transform: skew(-22deg); background: #fff3b8; box-shadow: 0 0 12rpx #e2d8ff; }.lightning view:first-child { margin: -30rpx 0 0 12rpx; }.lightning view:nth-child(2) { width: 38rpx; height: 14rpx; }.lightning view:last-child { margin: 30rpx 12rpx 0 0; }
@keyframes card-arrive { from { opacity: 0; transform: translateY(24rpx) scale(.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes flame-breathe { 50% { transform: rotate(-15deg) scale(.9,1.08); } }

.card-repair { border-color: #96cda3; background: linear-gradient(155deg, #f1fff2, #c7e6c5); }
.repair { position: relative; background: #91c59b; }
.repair view { position: absolute; width: 22rpx; height: 68rpx; border: 0; border-radius: 5rpx; background: #f5fff0; }
.repair view:nth-child(2) { transform: rotate(90deg); }
.repair view:last-child { display: none; }

.quality-crude { --quality-color:#92989b; }.quality-fine { --quality-color:#599c62; }.quality-rare { --quality-color:#438acb; }.quality-elite { --quality-color:#9b62c6; }.quality-legendary { --quality-color:#d9a331; }
.skill-card[class*="quality-"] { border-color:var(--quality-color,#f2d9a5); }
.quality-badge { display:inline-block; padding:5rpx 12rpx; border-radius:18rpx; background:var(--quality-color); color:#fff; font-size:21rpx; }

.pick-count { color:#fff8de; background:#365b49; border-radius:24rpx; padding:12rpx 26rpx; margin-bottom:24rpx; font-size:28rpx; font-weight:700; }

.skill-card { position: relative; }
.skill-guide { position:absolute; bottom:12rpx; right:12rpx; font-size:62rpx; line-height:1.2; pointer-events:none; animation:skill-point 800ms ease-in-out infinite; }
.guide-paused { animation-play-state:paused; }
@keyframes skill-point { 50% { transform:translateY(-14rpx); } }
