:host { display: block; width: 100%; }
.loading-chase { box-sizing: border-box; width: 600rpx; max-width: 100%; margin: 0 auto; padding: 28rpx 24rpx 24rpx; background: transparent; color: #344841; }
.chase-scene { position: relative; height: 210rpx; overflow: hidden; background: transparent; }
.runner { position: absolute; bottom: 12rpx; width: 174rpx; height: 194rpx; animation: run .28s ease-in-out infinite alternate; }
.runner image { position: absolute; inset: 0; width: 100%; height: 100%; animation: stride .36s steps(1, end) infinite; }
.runner .step-second { animation-delay: -.18s; }
.hero { left: 13%; z-index: 3; }
.pet { left: -3%; width: 140rpx; height: 160rpx; animation-delay: -.16s; z-index: 2; }
.zombie { right: -1%; animation-duration: .22s; }
.muzzle { position: absolute; right: -6rpx; top: 78rpx; font-size: 48rpx; color: #ffb132; text-shadow: 0 0 12rpx #ffdb63; animation: flash .44s steps(2, end) infinite; }
.chase-ground { position: absolute; bottom: 8rpx; width: 100%; height: 5rpx; background: repeating-linear-gradient(90deg, #b89250 0, #b89250 30rpx, transparent 30rpx, transparent 44rpx); animation: road .4s linear infinite; }
.bullet { position: absolute; top: 105rpx; left: 45%; width: 20rpx; height: 5rpx; border-radius: 6rpx; background: #ffbb46; box-shadow: -10rpx 0 0 #ffdb85; animation: shot .65s linear infinite; }
.bullet-two { animation-delay: -.32s; }
.magic { position: absolute; top: 140rpx; left: 21%; width: 14rpx; height: 14rpx; border-radius: 50%; background: #d1ffff; box-shadow: 0 0 5rpx 4rpx #73cadc, -18rpx 3rpx 8rpx #79a5e2; animation: spell 1.1s ease-in infinite; }
.magic-two { animation-delay: -.55s; }
.tear { position: absolute; top: 71rpx; left: 55rpx; width: 7rpx; height: 13rpx; border-radius: 60% 30% 60% 60%; background: #6ecdf0; animation: tears .5s ease-out infinite; }
.tear-two { left: 118rpx; animation-delay: -.25s; }
.dust { position: absolute; bottom: 13rpx; left: 12%; width: 17rpx; height: 13rpx; border-radius: 50%; background: #d4b878; animation: dust .6s ease-out infinite; }
.dust-two { left: 78%; animation-delay: -.3s; }
.speed-line { position: absolute; top: 50rpx; right: 22%; width: 48rpx; height: 3rpx; background: #dfb968; animation: wind .7s linear infinite; }
.line-two { top: 166rpx; right: 35%; animation-delay: -.35s; }
.progress-track { height: 14rpx; margin-top: 16rpx; border-radius: 12rpx; background: #dbc999; overflow: hidden; }
.progress-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #729c64, #a1c373); transition: width .18s ease-out; }
.loading-caption { display: flex; justify-content: space-between; align-items: center; margin-top: 18rpx; font-size: 26rpx; font-weight: bold; color: #fff; }
.percent { font-variant-numeric: tabular-nums; }
@keyframes run { from { transform: translateY(0) rotate(-3deg); } to { transform: translateY(-9rpx) rotate(3deg); } }
@keyframes road { to { background-position: -44rpx 0; } }
@keyframes flash { 0%, 55% { opacity: 1; } 56%, 100% { opacity: 0; } }
@keyframes shot { 0% { opacity: 0; transform: translateX(0); } 15% { opacity: 1; } 100% { opacity: 0; transform: translateX(145rpx); } }
@keyframes spell { 0% { opacity: 0; transform: translate(0, 0) scale(.5); } 20% { opacity: 1; } 100% { opacity: 0; transform: translate(300rpx, -35rpx) scale(1.2); } }
@keyframes tears { to { opacity: 0; transform: translate(-27rpx, 22rpx) rotate(35deg); } }
@keyframes dust { to { opacity: 0; transform: translate(-35rpx, -15rpx) scale(1.8); } }
@keyframes wind { to { opacity: 0; transform: translateX(-70rpx); } }

@keyframes stride { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
