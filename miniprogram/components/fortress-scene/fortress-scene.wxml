<view class="scene {{inputUnavailable ? 'scene-paused' : ''}} {{opening ? 'opening-scene' : ''}}">
  <view wx:if="{{opening && !completed && !failed}}" class="soldier-control">
    <button wx:if="{{soldierStockError}}" class="soldier-retry" bindtap="refreshSoldierStock" disabled="{{inputUnavailable}}">士兵库存读取失败 · 重试</button>
    <button wx:else class="soldier-summon" bindtap="summonSoldier" data-revision="{{soldierRevision}}" disabled="{{reviveOpen || soldierBusy || !soldierStock || soldiersInBattle >= 3 || inputUnavailable || !ready || !!error || !!upgradeOffer || !!waveRequest || hud.status !== 'fighting'}}" aria-label="召唤士兵，库存{{soldierStock}}，在场{{soldiersInBattle}}名，最多3名"><text>召唤士兵 ×{{soldierStock}}</text></button>
    <button wx:if="{{flagStockError}}" class="soldier-retry" bindtap="refreshFlags" disabled="{{inputUnavailable}}">旗帜读取失败 · 重试</button>
    <button wx:else class="soldier-summon" bindtap="openRevive" disabled="{{reviveOpen || !flagStock || !reviveTargets.length || inputUnavailable || !ready || !!error || !!upgradeOffer || !!waveRequest || hud.status !== 'fighting'}}"><text>⚑ 复活 ×{{flagStock}}</text></button>
    <text wx:if="{{soldierSummonError}}" class="soldier-error">{{soldierSummonError}}</text>
  </view>
  <view wx:if="{{reviveOpen}}" class="revive-overlay" role="dialog" aria-label="复活伙伴">
    <view class="revive-dialog"><text class="revive-title">复活伙伴</text><text>每次消耗 1 面旗帜 · 库存 {{flagStock}}</text>
      <scroll-view scroll-y class="revive-list"><button wx:for="{{reviveTargets}}" wx:key="id" data-kind="{{item.kind}}" data-id="{{item.id}}" data-revision="{{flagRevision}}" bindtap="chooseRevive" disabled="{{item.disabled || reviveBusy || inputUnavailable || flagStockError || !flagStock}}">{{item.label}} · {{item.disabled ? '士兵已满员' : '满血复活'}}</button></scroll-view>
      <text wx:if="{{reviveError}}" class="revive-error">{{reviveError}}</text><button wx:if="{{flagStockError}}" bindtap="refreshFlags" disabled="{{inputUnavailable}}">重试读取旗帜</button>
      <button bindtap="closeRevive" disabled="{{reviveBusy}}">取消</button>
    </view>
  </view>
  <view wx:if="{{bossNotice && !failed}}" class="boss-notice {{goldenLoot ? 'golden-loot' : ''}}" aria-live="polite"><text wx:if="{{goldenLoot}}" class="loot-star">★</text><text>{{bossNotice}}</text></view>
  <view wx:if="{{petReward}}" class="pet-reward" aria-live="polite"><button wx:if="{{petDropError}}" bindtap="retryPetDrops" disabled="{{inputUnavailable}}">{{petReward}}</button><text wx:else>{{petReward}}</text></view>
  <view wx:if="{{waveRequest}}" class="wave-modal"><view class="wave-dialog"><fortress-choice class="wave-choice" request="{{waveRequest}}" paused="{{paused}}" bindstartcombat="nextWave" /></view></view>
  <view wx:if="{{completed}}" class="victory-overlay" aria-label="挑战成功，达到20级，完成19波挑战">
    <view class="victory-glow" />
    <view class="fireworks" aria-hidden="true"><view wx:for="{{fireworks}}" wx:key="id" wx:for-item="burst" class="firework" style="left: {{burst.x}}%; top: {{burst.y}}%;"><view wx:for="{{fireworkRays}}" wx:key="id" class="firework-ray" style="transform: rotate({{item.angle}}deg)"><view class="firework-spark" style="background: {{item.color}}; box-shadow: 0 0 12rpx {{item.color}}; animation-delay: {{burst.delay}}ms" /></view></view></view>
    <view class="victory-particles" aria-hidden="true"><view wx:for="{{victoryParticles}}" wx:key="id" class="victory-particle" style="left: {{item.left}}%; background: {{item.color}}; animation-delay: {{item.delay}}ms; animation-duration: {{item.duration}}ms;" /></view>
    <view class="victory-content">
      <view class="victory-medal" aria-hidden="true"><view class="medal-ribbon ribbon-left" /><view class="medal-ribbon ribbon-right" /><view class="medal-face"><text class="medal-star">★</text><text class="medal-level">Lv. {{level}}</text></view></view>
      <text class="victory-title">挑战成功</text>
      <text class="victory-subtitle">小屋守住了！</text>
      <view class="victory-results"><view><text class="result-number">{{waveCount}}</text><text>波全部完成</text></view><view><text class="result-number">{{experience}}</text><text>本局经验</text></view></view>
      <view class="victory-reward"><view class="reward-coin">●</view><text wx:if="{{rewardSaved}}">＋{{rewardCoins}} 金币</text><button wx:elif="{{rewardError}}" bindtap="claimVictoryReward">奖励暂未保存，点击重试</button><text wx:else>金币奖励到账中…</text></view>
      <view class="victory-collection"><text class="collection-title">本局练习 · {{victoryFruits.length}} 个单词</text><view class="victory-fruits"><view wx:for="{{victoryFruits}}" wx:key="id" class="victory-fruit" style="animation-delay: {{item.delay}}ms"><image src="{{item.image}}" mode="aspectFit" /></view></view></view>
      <button wx:if="{{canContinue}}" class="victory-continue" bindtap="continueStage" disabled="{{!rewardSaved || dropError || petDropError || continueBusy || inputUnavailable}}">{{continueBusy ? '准备下一关…' : continueError ? '资源加载失败，重试下一关' : '继续下一关'}}</button>
      <button class="victory-home" bindtap="returnHome">返回小屋</button>
    </view>
  </view>
  <view wx:if="{{skillQuiz}}" class="wave-modal"><view class="wave-dialog"><fortress-choice class="skill-quiz" request="{{skillQuiz}}" paused="{{inputUnavailable || !!error}}" bindstartcombat="finishSkillQuiz" /></view></view>
  <skill-choice wx:if="{{!skillQuiz}}" class="upgrade-choice" remaining="{{skillPicksRemaining}}" offer="{{upgradeOffer}}" show-guide="{{skillShowGuide}}" disabled="{{inputUnavailable || !!error}}" bindselectskill="chooseUpgrade" />
  <view wx:if="{{dropError}}" class="drop-error"><button disabled="{{inputUnavailable}}" bindtap="retryDrops">掉落金币未到账，点击重试</button></view>
  <view wx:if="{{voiceError && !upgradeOffer}}" class="voice-status"><button bindtap="retryVoice">重试发音</button></view>
  <view wx:if="{{!opening}}" class="hud" aria-label="基地剩余 {{hud.hp}} / {{hud.maxHp}} 血量">
    <text>堡垒基地</text><view class="health-track"><view class="health-fill" style="width: {{hpPercent}}%"></view></view><text>{{hud.hp}} / {{hud.maxHp}}</text>
  </view>
  <view wx:if="{{error}}" class="scene-status"><text>战场暂时无法打开</text><text class="error-detail">{{error}}</text><button bindtap="retry">重试</button></view>
  <view wx:elif="{{!ready && !opening}}" class="scene-status">正在准备战场…</view>
  <view wx:elif="{{retirement}}" class="scene-status retirement">
    <view class="retirement-word"><image src="{{retirement.fruitImagePath}}" mode="aspectFit" /><text>{{retirement.word}}</text></view>
    <text wx:if="{{paused}}">已暂停</text>
    <block wx:elif="{{retirement.phase === 'audioError'}}"><text>读词暂时失败</text><view class="retirement-actions"><button bindtap="retryRetirement">再听一次</button><button bindtap="continueRetirement">继续</button></view></block>
    <text wx:elif="{{retirement.phase === 'done'}}">本波怪物已击败</text>
  </view>
  <view wx:elif="{{!opening && hud.status !== 'fighting'}}" class="scene-status">{{hud.status === 'baseDestroyed' ? '基地被摧毁' : (opening ? '本批僵尸已击败' : '本波怪物已击败')}}</view>
  <view wx:elif="{{paused && !opening}}" class="scene-status">已暂停</view>
  <view wx:if="{{skillOffer}}" class="skill-panel">
    <block wx:if="{{skillOffer.status === 'offered'}}">
      <text>选一个技能，强化守护者</text>
      <view class="skill-cards"><button wx:for="{{skillCards}}" wx:key="id" disabled="{{paused}}" data-offer-id="{{skillOffer.offer.offerId}}" data-skill-id="{{item.id}}" bindtap="choosePreviewSkill"><text>{{item.label}}</text><text class="skill-detail">{{item.description}}</text></button></view>
      <text class="skill-detail">仅本局有效</text>
    </block>
    <block wx:else><text>技能已获得</text><text>{{skillSummary}}</text><text class="skill-detail">开发预览：下一波听词流程待接入</text></block>
  </view>

  <view wx:if="{{failed}}" class="defeat-overlay" role="dialog" aria-label="战斗失败">
    <view class="crying-hero" aria-hidden="true"><view class="crying-helmet" /><view class="crying-eye left-eye" /><view class="crying-eye right-eye" /><view class="crying-mouth" /><view class="crying-tear left-tear" /><view class="crying-tear right-tear" /></view>
    <text class="defeat-title">这次没能守住小屋</text><text class="defeat-subtitle">变强一点，下次再来！</text>
    <button class="strengthen-button" bindtap="becomeStronger" disabled="{{inputUnavailable}}">我要变强</button>
  </view>
  <view class="canvas-stage"><image wx:if="{{(reviveOpen || upgradeOffer || waveRequest || completed || failed) && frozenFrame}}" class="frozen-frame" src="{{frozenFrame}}" mode="scaleToFill" /><canvas wx:if="{{!waveRequest}}" hidden="{{reviveOpen || !!upgradeOffer || completed || failed || !!error}}" type="2d" id="battle-canvas" class="battle-canvas" /></view>
  <view wx:if="{{opening}}" class="battle-footer"><text>Lv. {{level}}</text><view class="health-track"><view class="health-fill" style="width: {{hpPercent}}%"></view></view><text wx:if="{{level >= 20}}" class="experience-cap" aria-label="已满级，经验上限无限，清空剩余僵尸即可通关">经验 {{xpCurrent}} / ∞ · 清场</text><view wx:else class="level-experience" aria-label="当前等级经验 {{xpCurrent}} / {{xpRequired}}"><text class="experience-value">经验 {{xpCurrent}} / {{xpRequired}}</text><view class="experience-track" role="progressbar" aria-valuemin="0" aria-valuemax="{{xpRequired}}" aria-valuenow="{{xpCurrent}}"><view style="width: {{xpPercent}}%"></view></view></view><text class="drop-coins" aria-label="本局击杀已获得{{dropCoins}}金币">● {{dropCoins}}</text></view>
  <view wx:if="{{!opening}}" class="control {{paused || !ready || hud.status !== 'fighting' ? 'disabled' : ''}}"
    catchtouchstart="touchStart" catchtouchmove="touchMove" catchtouchend="touchEnd" catchtouchcancel="touchCancel">
    <text>‹ 左右拖动 ›</text>
  </view>
</view>
