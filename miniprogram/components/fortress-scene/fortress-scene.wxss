:host { display: block; width: 100%; }
.scene { width: 100%; color: #e8f3df; }
.hud { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 20rpx; background: #20434a; border-radius: 20rpx 20rpx 0 0; font-size: 24rpx; }
.health-track { flex: 1; height: 16rpx; border-radius: 12rpx; overflow: hidden; background: #102c34; }
.health-fill { height: 100%; background: #7ee0ab; transition: width 120ms; }
.canvas-stage { position: relative; height: 800rpx; }.battle-canvas { display: block; width: 100%; height: 100%; }.frozen-frame { position: absolute; inset: 0; width: 100%; height: 100%; }
.scene-status { display: flex; flex-direction: column; align-items: center; gap: 12rpx; background: #20434a; font-size: 28rpx; padding: 12rpx 24rpx; text-align: center; }
.error-detail { font-size: 24rpx; color: #f8d7ad; overflow-wrap: anywhere; }
.scene-status button { background: #e1efbc; color: #20434a; font-size: 28rpx; }
.control { padding: 28rpx 0; text-align: center; background: #2d5860; font-size: 28rpx; border-radius: 0 0 20rpx 20rpx; }
.control.disabled { opacity: .55; }
.retirement-word { display: flex; align-items: center; gap: 20rpx; }
.retirement-word image { width: 56rpx; height: 56rpx; }
.retirement-actions { display: flex; gap: 20rpx; }
.skill-panel { padding: 24rpx; background: #eaf3d5; color: #20434a; display: flex; flex-direction: column; gap: 16rpx; text-align: center; }
.skill-cards { display: flex; gap: 16rpx; }
.skill-cards button { flex: 1; padding: 20rpx 8rpx; margin: 0; background: #fff; color: #20434a; font-size: 28rpx; }
.skill-detail { display: block; font-size: 22rpx; line-height: 1.6; }

.experience-hud { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 20rpx; background: #334b40; color: #eaf2d0; font-size: 24rpx; }
.experience-track { flex: 1; height: 12rpx; border-radius: 10rpx; overflow: hidden; background: #20352b; }.experience-track view { height: 100%; background: #e3cd7c; }
.opening-scene .hud { background: #52684e; border-radius: 0; }.opening-scene .canvas-stage { height: 66vh; min-height: 680rpx; }.opening-scene .control { background: #52684e; border-radius: 0; padding: 18rpx; font-size: 24rpx; }
.upgrade-summary { background: #e6efcf; color: #3b553d; text-align: center; padding: 16rpx; font-size: 25rpx; }.return-home { margin: 20rpx auto; width: 270rpx; border-radius: 36rpx; background: #dce9be; color: #3c573d; font-size: 28rpx; }

.wave-modal { position: fixed; inset: 0; z-index: 100; background: rgba(22,42,33,.55); display: flex; align-items: center; justify-content: center; }.wave-dialog { width: 660rpx; padding: 44rpx 10rpx; box-sizing: border-box; border-radius: 40rpx; background: #fff8e5; }.settlement { padding: 28rpx; display: flex; flex-direction: column; gap: 16rpx; align-items: center; background: #e6efcf; color: #3b553d; }

.voice-status { display: flex; justify-content: center; align-items: center; gap: 20rpx; min-height: 44rpx; background: #e6efcf; color: #3b553d; font-size: 28rpx; }.voice-status button { margin: 0; font-size: 24rpx; }

/* Opening battlefield never participates in status-message layout. */
.opening-scene { position: relative; height: calc(100vh - 54rpx); overflow: hidden; }
.opening-scene .canvas-stage { position: absolute; top: 0; left: 0; right: 0; height: calc(100% - 170rpx - env(safe-area-inset-bottom)); min-height: 0; }
.battle-footer { position: absolute; bottom: env(safe-area-inset-bottom); left: 0; right: 0; height: 80rpx; box-sizing: border-box; display: flex; gap: 20rpx; align-items: center; padding: 12rpx 24rpx; font-size: 24rpx; background: #334b40; }
.battle-footer .level-experience { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.battle-footer .experience-value { color: #ffe49a; font-size: 19rpx; line-height: 24rpx; text-align: center; }
.battle-footer .experience-track { flex: none; width: 100%; }
.battle-footer .experience-cap { flex: 1; color: #ffe49a; font-size: 20rpx; text-align: center; }
.drop-coins { color: #ffe18c; min-width: 68rpx; text-align: right; }
.drop-error { position: absolute; bottom: calc(90rpx + env(safe-area-inset-bottom)); left: 12%; right: 12%; z-index: 120; }
.drop-error button { font-size: 24rpx; color: #594523; background: #ffebac; }
.opening-scene .scene-status, .opening-scene .settlement { position: absolute; z-index: 20; top: 35%; left: 5%; width: 90%; box-sizing: border-box; border-radius: 28rpx; }
.opening-scene .return-home { position: absolute; z-index: 21; bottom: 120rpx; left: 50%; transform: translateX(-50%); margin: 0; }
.opening-scene .voice-status { position: absolute; z-index: 21; bottom: env(safe-area-inset-bottom); left: 0; right: 0; height: 80rpx; }

/* Victory occupies an overlay; its animation cannot move the battlefield. */
.victory-overlay { position: absolute; inset: 0; z-index: 110; overflow: hidden; display: flex; align-items: center; justify-content: center; background: rgba(13, 31, 30, .93); animation: victory-fade 280ms ease-out both; }
.victory-glow { position: absolute; top: 3%; left: -15%; width: 130%; height: 65%; border-radius: 50%; background: radial-gradient(ellipse, rgba(255,210,103,.3), rgba(255,210,103,0) 68%); animation: victory-glow-in 1300ms ease-out both; }
.victory-content { position: relative; z-index: 2; width: 86%; max-width: 640rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.victory-medal { position: relative; width: 210rpx; height: 230rpx; animation: victory-pop 650ms cubic-bezier(.2,.8,.25,1.2) both; }
.medal-face { position: relative; z-index: 2; box-sizing: border-box; width: 200rpx; height: 200rpx; border-radius: 50%; border: 10rpx solid #f9d278; background: linear-gradient(145deg, #fff3bc, #e2a13b); box-shadow: 0 0 0 5rpx #a76c27, 0 0 60rpx rgba(255,214,107,.35), inset 0 0 0 5rpx #c18b39; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #785124; }
.medal-star { font-size: 92rpx; line-height: 1; text-shadow: 0 3rpx #fff2bb; }.medal-level { font-size: 25rpx; font-weight: bold; margin-top: 6rpx; }
.medal-ribbon { position: absolute; top: 130rpx; width: 64rpx; height: 100rpx; background: #db7353; border: 4rpx solid #ffc18a; }.ribbon-left { left: 30rpx; transform: rotate(22deg); }.ribbon-right { right: 40rpx; transform: rotate(-22deg); }
.victory-title { margin-top: 16rpx; color: #ffe9a8; font-size: 64rpx; font-weight: 900; letter-spacing: 8rpx; text-shadow: 0 5rpx #79502b; animation: victory-rise 500ms 180ms both; }
.victory-subtitle { color: #d4e5d2; font-size: 26rpx; margin: 14rpx 0 28rpx; animation: victory-rise 500ms 300ms both; }
.victory-results { display: flex; width: 100%; padding: 24rpx 0; border-top: 1rpx solid #68816b; border-bottom: 1rpx solid #68816b; animation: victory-rise 450ms 450ms both; }.victory-results > view { width: 50%; display: flex; flex-direction: column; gap: 8rpx; color: #bfcfbf; font-size: 23rpx; }.victory-results .result-number { color: #ffe4a0; font-size: 42rpx; font-weight: bold; }
.victory-collection { width: 100%; margin-top: 28rpx; }.collection-title { color: #e9efda; font-size: 25rpx; animation: victory-fade 400ms 550ms both; }.victory-fruits { display: flex; flex-wrap: wrap; justify-content: center; gap: 12rpx; margin: 22rpx auto 0; max-width: 550rpx; }.victory-fruit { width: 76rpx; height: 76rpx; border: 2rpx solid #9d945c; border-radius: 20rpx; background: linear-gradient(145deg, #52644c, #2b4238); animation: victory-pop 450ms both; }.victory-fruit image { width: 64rpx; height: 64rpx; margin-top: 6rpx; }
.victory-home { margin: 34rpx 0 0; width: 360rpx; border-radius: 48rpx; background: linear-gradient(#ffe6a0, #e8b957); color: #4e4329; font-size: 30rpx; font-weight: bold; box-shadow: 0 6rpx 0 #96703b; animation: victory-rise 450ms 1300ms both; }
.victory-particles { position: absolute; inset: 0; pointer-events: none; }.victory-particle { position: absolute; top: -5%; width: 12rpx; height: 24rpx; border-radius: 3rpx; animation-name: victory-confetti; animation-timing-function: ease-out; animation-fill-mode: both; }
@keyframes victory-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes victory-pop { 0% { opacity: 0; transform: scale(.25) rotate(-12deg); } 70% { opacity: 1; transform: scale(1.08) rotate(3deg); } 100% { opacity: 1; transform: scale(1) rotate(0); } }
@keyframes victory-rise { from { opacity: 0; transform: translateY(24rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes victory-glow-in { from { opacity: 0; transform: scale(.3); } to { opacity: 1; transform: scale(1); } }
@keyframes victory-confetti { 0% { opacity: 0; transform: translateY(0) rotate(0); } 12% { opacity: 1; } 80% { opacity: 1; } 100% { opacity: 0; transform: translateY(110vh) rotate(540deg); } }
@media (max-height: 650px) { .victory-medal { width: 160rpx; height: 160rpx; transform-origin: top center; margin-bottom: -25rpx; }.medal-face { width: 140rpx; height: 140rpx; }.medal-star { font-size: 60rpx; }.medal-level { font-size: 20rpx; }.medal-ribbon { top: 80rpx; height: 70rpx; width: 40rpx; }.victory-title { font-size: 50rpx; }.victory-subtitle { margin-bottom: 16rpx; }.victory-results { padding: 12rpx 0; }.victory-collection { margin-top: 18rpx; }.victory-home { margin-top: 22rpx; } }

.fireworks { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }.firework { position: absolute; width: 1rpx; height: 1rpx; }.firework-ray { position: absolute; width: 1rpx; height: 1rpx; }.firework-spark { position: absolute; width: 8rpx; height: 18rpx; border-radius: 50%; animation: firework-burst 1600ms cubic-bezier(.15,.65,.3,1) both; }
@keyframes firework-burst { 0% { opacity: 0; transform: translateY(0) scale(.2); } 8% { opacity: 1; } 65% { opacity: 1; transform: translateY(-130rpx) scale(1); } 100% { opacity: 0; transform: translateY(-175rpx) scale(.3); } }
.victory-reward { display: flex; align-items: center; justify-content: center; gap: 16rpx; margin-top: 20rpx; color: #ffe49a; font-size: 34rpx; font-weight: bold; animation: victory-pop 500ms 650ms both; }.reward-coin { width: 48rpx; height: 48rpx; border-radius: 50%; border: 4rpx solid #e9ac3e; background: #ffe389; color: #c38b2e; font-size: 22rpx; line-height: 48rpx; }.victory-reward button { font-size: 22rpx; color: #614719; background: #ffe5a6; margin: 0; }.victory-collection { margin-top: 20rpx; }.victory-home { margin-top: 24rpx; }
@media (max-height: 650px) { .victory-reward { margin-top: 12rpx; font-size: 28rpx; }.victory-collection { margin-top: 12rpx; }.victory-fruits { margin-top: 14rpx; } }

.victory-fruit { width: 60rpx; height: 60rpx; border-radius: 16rpx; }.victory-fruit image { width: 52rpx; height: 52rpx; margin-top: 4rpx; }

/* Freeze the complete celebration, including delayed effects, while hidden or paused. */
.scene-paused .victory-overlay,
.scene-paused .victory-glow,
.scene-paused .victory-medal,
.scene-paused .victory-title,
.scene-paused .victory-subtitle,
.scene-paused .victory-results,
.scene-paused .collection-title,
.scene-paused .victory-fruit,
.scene-paused .victory-home,
.scene-paused .victory-particle,
.scene-paused .firework-spark,
.scene-paused .victory-reward { animation-play-state: paused; }

.pet-reward { position:absolute; top:12rpx; left:12%; right:12%; z-index:120; padding:12rpx; border-radius:18rpx; text-align:center; background:#fff1cce8; color:#486052; font-size:24rpx; pointer-events:none; }.pet-reward button { pointer-events:auto; font-size:24rpx; }

.defeat-overlay { position:absolute; inset:0; z-index:110; display:flex; flex-direction:column; align-items:center; justify-content:center; background:rgba(28,44,58,.93); color:#f5f0df; }
.crying-hero { position:relative; width:200rpx; height:190rpx; margin-bottom:50rpx; border-radius:44% 44% 48% 48%; background:#e7bb8b; box-shadow:0 14rpx 0 #162d3b55; animation:sad-rock 1600ms ease-in-out infinite; }
.crying-helmet { position:absolute; top:-22rpx; left:-12rpx; width:224rpx; height:90rpx; border-radius:110rpx 110rpx 22rpx 22rpx; background:#91a56f; border-bottom:14rpx solid #bdcb93; }
.crying-eye { position:absolute; top:95rpx; width:40rpx; height:15rpx; border-top:7rpx solid #665743; border-radius:50%; }.left-eye { left:33rpx; transform:rotate(-12deg); }.right-eye { right:33rpx; transform:rotate(12deg); }
.crying-mouth { position:absolute; top:145rpx; left:78rpx; width:44rpx; height:20rpx; border-top:6rpx solid #9b685c; border-radius:50%; }
.crying-tear { position:absolute; top:112rpx; width:17rpx; height:30rpx; border-radius:50% 50% 55% 55%; background:#9adbed; animation:sad-tear 1100ms ease-in infinite; }.left-tear { left:44rpx; }.right-tear { right:44rpx; animation-delay:450ms; }
.defeat-title { font-size:36rpx; font-weight:bold; }.defeat-subtitle { margin:22rpx 0 50rpx; color:#bdcddb; font-size:26rpx; }.strengthen-button { width:350rpx; border-radius:50rpx; background:#f0d58c; color:#4e583f; font-size:32rpx; font-weight:bold; }
@keyframes sad-rock { 0%,100% { transform:rotate(-4deg) translateY(0); } 50% { transform:rotate(4deg) translateY(7rpx); } }
@keyframes sad-tear { 0% { opacity:0; transform:translateY(0); } 20% { opacity:1; } 100% { opacity:0; transform:translateY(90rpx); } }
.scene-paused .crying-hero,.scene-paused .crying-tear { animation-play-state:paused; }

.boss-notice { position:absolute; z-index:6; top:110rpx; left:20rpx; right:20rpx; text-align:center; color:#fff5d1; background:rgba(59,43,26,.85); border-radius:20rpx; padding:14rpx; pointer-events:none; }
.golden-loot { border:2rpx solid #f6d266; background:linear-gradient(120deg,#694819,#b77a24,#694819); box-shadow:0 0 30rpx #edc25a; animation:loot-arrival 1.5s ease-out; }
.loot-star { display:inline-block; color:#ffe99a; font-size:44rpx; margin-right:14rpx; animation:loot-star 1.5s ease-out; }
@keyframes loot-arrival { from { opacity:0; transform:scale(.65); } 50% { opacity:1; transform:scale(1.08); } to { transform:scale(1); } }
@keyframes loot-star { from { transform:rotate(-180deg) scale(.3); } to { transform:rotate(0) scale(1); } }
.scene-paused .golden-loot, .scene-paused .loot-star { animation-play-state:paused; }

.victory-continue { margin-top:18rpx; width:80%; border-radius:36rpx; background:#e8bd58; color:#45321b; font-weight:700; font-size:28rpx; }

.soldier-control { position:absolute; z-index:5; left:0; right:0; bottom:calc(env(safe-area-inset-bottom) + 80rpx); height:90rpx; box-sizing:border-box; padding:6rpx 20rpx; display:flex; align-items:center; justify-content:flex-end; gap:16rpx; background:#334b40; text-align:center; }.soldier-control .soldier-summon,.soldier-control .soldier-retry { display:flex; flex-direction:column; width:auto; min-width:0; margin:0; padding:4rpx 16rpx; border:3rpx solid #f3e9c3; border-radius:20rpx; background:#729456; color:#fff8dd; font-size:23rpx; line-height:1.5; box-shadow:0 4rpx 0 #3d5d3d; }.soldier-control .soldier-summon::after,.soldier-control .soldier-retry::after { border:0; }.soldier-control .soldier-summon[disabled],.soldier-control .soldier-retry[disabled] { background:#71816b; color:#d5ddc8; border-color:#a5b49a; box-shadow:none; }.soldier-count { font-size:20rpx; }.soldier-error { flex:1; display:block; padding:8rpx; border-radius:10rpx; margin-top:0; background:#fff0d9; color:#8a483b; font-size:21rpx; }

.revive-overlay { position:absolute; inset:0; z-index:35; background:rgba(16,35,30,.72); display:flex; align-items:center; justify-content:center; }
.revive-dialog { width:570rpx; max-height:80%; box-sizing:border-box; padding:28rpx; border:5rpx solid #e7d8a9; border-radius:28rpx; background:#edf0d7; color:#344d3d; display:flex; flex-direction:column; gap:18rpx; text-align:center; }
.revive-title { font-size:36rpx; font-weight:bold; }.revive-list { height:360rpx; }.revive-dialog button { margin:12rpx 0; background:#729456; color:#fff8dd; font-size:28rpx; }.revive-dialog button[disabled] { background:#a3aa94; color:#eef1e5; }.revive-error { color:#9b493d; font-size:24rpx; }
