.weapon-backdrop { position:fixed; inset:0; z-index:20; display:flex; align-items:center; justify-content:center; padding:32rpx; background:#203b3a99; }
.weapon-panel { position:relative; width:100%; max-width:640rpx; box-sizing:border-box; padding:40rpx 30rpx 32rpx; border:6rpx solid #fff9e4; border-radius:44rpx; background:#fff8e7; text-align:center; box-shadow:0 16rpx 0 #243d3d33; }
.weapon-title { font-size:36rpx; color:#456452; font-weight:700; }
.weapon-close { position:absolute; top:12rpx; right:12rpx; width:64rpx; min-width:0; max-width:64rpx; height:64rpx; padding:0; line-height:58rpx; border-radius:50%; background:transparent; color:#7c826c; font-size:48rpx; }
button::after { border:0; }
.weapon-level { display:inline-block; margin-top:24rpx; padding:8rpx 22rpx; border-bottom:6rpx solid; color:#53664e; font-size:27rpx; }
.weapon-carousel { display:flex; align-items:center; justify-content:space-between; gap:8rpx; }
.weapon-nav { flex:0 0 68rpx; width:68rpx; min-width:0; max-width:68rpx; height:88rpx; padding:0; border-radius:28rpx; background:#e3ebd2; color:#526d4d; font-size:58rpx; line-height:78rpx; }
.weapon-nav[disabled] { opacity:.35; }
.weapon-stage { flex:1; min-width:0; height:300rpx; margin:16rpx 0; display:flex; align-items:center; justify-content:center; border-radius:50%; }
.weapon-stage-ultimate { animation:golden-weapon-glow 1.6s ease-in-out infinite alternate; box-shadow:0 0 24rpx #ffd83d99, inset 0 0 40rpx #ffe35966; }
.weapon-image { width:100%; height:280rpx; }
.weapon-image-ultimate { filter:drop-shadow(0 0 8rpx #fff36b) drop-shadow(0 0 18rpx #ffc928); }
@keyframes golden-weapon-glow { from { box-shadow:0 0 18rpx #ffd83d88, inset 0 0 26rpx #ffe35944; } to { box-shadow:0 0 42rpx #ffd52d, inset 0 0 54rpx #ffe359aa; } }
.coin { display:block; width:40rpx; height:40rpx; flex-shrink:0; }
.weapon-upgrade { position:relative; width:300rpx; min-width:0; max-width:300rpx; padding:0; height:88rpx; border-radius:28rpx; background:#83b749; color:#fffbe7; overflow:hidden; box-shadow:0 6rpx 0 #58783d; }
.weapon-upgrade[disabled] { background:#c3cbb2; color:#62705c; box-shadow:0 6rpx 0 #9aa68a; }
.hold-progress { position:absolute; left:0; top:0; height:100%; background:#d3ef8799; }
.upgrade-label { position:relative; height:100%; display:flex; gap:16rpx; align-items:center; justify-content:center; font-size:34rpx; font-weight:700; }
.weapon-hint { margin-top:24rpx; color:#77816c; font-size:24rpx; }
.weapon-preview-note { color:#71805e; font-size:27rpx; padding:22rpx 0; }
.weapon-error { color:#9a5643; font-size:26rpx; }.weapon-retry { width:180rpx; min-width:0; font-size:26rpx; margin-top:12rpx; color:#49654a; background:#d8efcf; }

.weapon-damage { width:72%; min-height:64rpx; margin:0 auto 20rpx; display:flex; align-items:center; justify-content:space-between; }
.weapon-damage-label { color:#53664e; font-size:27rpx; }
.weapon-damage-value { color:#db8b24; font-size:42rpx; line-height:1; font-weight:800; text-shadow:0 2rpx 0 #ffe5a3; }

.weapon-design { margin-top:12rpx; color:#687e80; font-size:24rpx; letter-spacing:4rpx; }
.weapon-stage { position:relative; }
.weapon-image { position:relative; z-index:1; }
.energy-orbit { position:absolute; width:82%; height:48%; border:2rpx solid; border-left-color:transparent !important; border-right-color:transparent !important; border-radius:50%; opacity:.7; transform:rotate(-18deg); animation:weapon-orbit 5s linear infinite; }
.energy-orbit-second { width:70%; height:70%; animation-direction:reverse; animation-duration:7s; }
.weapon-stage-level-4 .weapon-image, .weapon-stage-level-5 .weapon-image, .weapon-stage-level-6 .weapon-image { animation:weapon-hover 2.8s ease-in-out infinite alternate; }
@keyframes weapon-orbit { to { transform:rotate(342deg); } }
@keyframes weapon-hover { to { transform:translateY(-8rpx); } }
