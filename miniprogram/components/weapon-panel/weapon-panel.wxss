.weapon-backdrop { position:fixed; inset:0; z-index:20; display:flex; align-items:center; justify-content:center; padding:32rpx; background:#203b3a99; }
.weapon-panel { position:relative; width:100%; max-width:640rpx; box-sizing:border-box; padding:40rpx 30rpx 32rpx; border:6rpx solid #fff9e4; border-radius:44rpx; background:#fff8e7; text-align:center; box-shadow:0 16rpx 0 #243d3d33; }
.weapon-title { font-size:36rpx; color:#456452; font-weight:700; }
.weapon-close { position:absolute; top:12rpx; right:12rpx; width:64rpx; min-width:0; max-width:64rpx; height:64rpx; padding:0; line-height:58rpx; border-radius:50%; background:transparent; color:#7c826c; font-size:48rpx; }
button::after { border:0; }
.weapon-level { display:inline-block; margin-top:24rpx; padding:8rpx 22rpx; border-bottom:6rpx solid; color:#53664e; font-size:27rpx; }
.weapon-stage { height:300rpx; margin:16rpx 0; display:flex; align-items:center; justify-content:center; }
.weapon-image { width:100%; height:280rpx; }
.weapon-balance { color:#7a5422; font-size:28rpx; margin-bottom:24rpx; }
.coin { display:inline-flex; justify-content:center; align-items:center; width:34rpx; height:34rpx; border:3rpx solid #e5a83b; border-radius:50%; background:#ffe08a; color:#cb8e24; font-size:16rpx; }
.weapon-upgrade { position:relative; width:300rpx; min-width:0; max-width:300rpx; padding:0; height:88rpx; border-radius:28rpx; background:#83b749; color:#fffbe7; overflow:hidden; box-shadow:0 6rpx 0 #58783d; }
.weapon-upgrade[disabled] { background:#c3cbb2; color:#62705c; box-shadow:0 6rpx 0 #9aa68a; }
.hold-progress { position:absolute; left:0; top:0; height:100%; background:#d3ef8799; }
.upgrade-label { position:relative; height:100%; display:flex; gap:16rpx; align-items:center; justify-content:center; font-size:34rpx; font-weight:700; }
.weapon-hint { margin-top:24rpx; color:#77816c; font-size:24rpx; }
.weapon-error { color:#9a5643; font-size:26rpx; }.weapon-retry { width:180rpx; min-width:0; font-size:26rpx; margin-top:12rpx; color:#49654a; background:#d8efcf; }

.weapon-damage { margin-bottom:12rpx; color:#53664e; font-size:26rpx; }
