page {
  min-height: 100%;
  background: #fff8ec;
  color: #25483d;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 56rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.title { font-size: 56rpx; font-weight: 800; line-height: 1.3; }
.description { font-size: 30rpx; line-height: 1.8; color: #587166; }
.primary-button {
  width: 100%;
  min-height: 100rpx;
  border-radius: 32rpx;
  background: #246b51;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 100rpx;
}
.primary-button::after { border: 0; }
.primary-button[disabled] { background: #83a391; color: #fff; }
