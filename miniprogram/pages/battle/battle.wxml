<view wx:if="{{preview}}" class="preview-page {{fromHome ? 'opening-page' : ''}}">
  <view wx:if="{{fromHome}}" class="battle-toolbar"><button bindtap="returnHome" aria-label="返回首页">‹</button><view class="battle-speed"><button class="speed-trigger" bindtap="cycleCombatSpeed" aria-label="游戏加速，当前{{combatSpeed}}倍">»</button><text>{{combatSpeed}}×</text></view><view class="battle-volume"><button class="volume-trigger" bindtap="openVolume" aria-label="调节战斗声音"><view class="speaker-icon" aria-hidden="true"></view></button><text>{{musicVolume}}%</text></view><button class="pause-button" bindtap="togglePreviewPause" aria-label="{{previewPaused ? '继续' : '暂停'}}">{{previewPaused ? '▶' : 'Ⅱ'}}</button><view class="toolbar-wallet" aria-label="当前金币 {{coinBalance}}"><text>●</text>{{coinBalance}}</view></view>
  <view wx:if="{{fromHome && volumeOpen}}" class="volume-overlay" bindtap="closeVolume"><view class="volume-dialog" catchtap="noop"><view class="volume-heading"><text>战斗声音</text><button bindtap="closeVolume" aria-label="关闭音量窗口">×</button></view><text class="volume-description">背景音乐和战斗音效</text><view class="volume-control"><slider min="0" max="100" step="1" value="{{musicVolume}}" block-size="20" activeColor="#e3cd7c" backgroundColor="#617568" bindchanging="changeMusicVolume" bindchange="changeMusicVolume" aria-label="背景音乐和战斗音效音量" /><text>{{musicVolume}}%</text></view></view></view>
  <view wx:if="{{!fromHome}}" class="preview-kicker">开发预览 · {{choicePreview ? '听词选怪与一波战斗' : '水果角色已接入'}}</view>
  <view wx:if="{{!fromHome}}" class="preview-title">堡垒守卫</view>
  <view wx:if="{{!fromHome}}" class="preview-note">{{choicePreview ? '先听单词、选怪物，再左右移动打怪。' : '五种水果角色素材检查；'}}基地、主角与武器仍为开发占位。</view>
  <view wx:if="{{!choicePreview && !fromHome}}" class="preview-monsters"><button wx:for="{{previewWords}}" wx:key="id" data-word-id="{{item.id}}" bindtap="selectPreviewMonster" class="{{previewWord === item.id ? 'selected' : ''}}">{{item.meaningZh}}</button></view>
  <fortress-choice wx:if="{{choicePreview && !choiceStarted}}" class="fortress-choice-preview" request="{{choiceRequest}}" music-volume="{{musicVolume}}" paused="{{previewPaused}}" bindstartcombat="startChoiceCombat" />
  <fortress-scene wx:else class="fortress-preview" preview="{{!fromHome}}" opening="{{fromHome}}" loading-cover="{{fromHome ? loadingCover : ''}}" loading-color="{{fromHome ? loadingColor : '#112c36'}}" music-volume="{{musicVolume}}" combat-speed="{{combatSpeed}}" bindreturnhome="returnHome" bindstrengthenguide="becomeStronger" bindcoinbalancechange="updateCoinBalance" preview-word="{{previewWord}}" preview-request="{{choicePreview || fromHome ? choiceRequest : null}}" paused="{{previewPaused}}" />
  <view wx:if="{{!fromHome}}" class="preview-actions"><button class="pause-button" bindtap="togglePreviewPause">{{previewPaused ? '开始 / 继续预览' : '暂停'}}</button><button bindtap="restartPreview">重新预览</button></view>
</view>
<view class="page battle" wx:if="{{view}}">
  <view class="phase">{{view.phaseLabel}}</view>
  <view class="phase-progress" wx:if="{{view.phaseProgress}}">{{view.phaseProgress}}</view>
  <view class="phase-instruction">{{view.phaseInstruction}}</view>
  <view wx:if="{{view.shields.length}}" class="shield-panel" aria-label="剩余 {{view.shieldsRemaining}} 层护盾">
    <view class="shield-row" aria-hidden="true">
      <view wx:for="{{view.shields}}" wx:key="index" class="shield {{item.intact ? 'intact' : 'removed'}}"></view>
    </view>
    <view class="shield-caption">剩余 {{view.shieldsRemaining}} 层护盾</view>
  </view>
  <view class="status" aria-live="polite">{{view.message}}</view>
  <view class="arena">
    <view class="targets" wx:if="{{view.status !== 'completed'}}">
      <button wx:for="{{view.cards}}" wx:key="key"
        class="target {{item.hint ? 'hinted' : ''}} {{item.attacked ? 'attacked' : ''}}"
        disabled="{{!view.canChoose}}" aria-label="{{item.label}}"
        data-session-id="{{view.context.sessionId}}" data-round-id="{{view.context.roundId}}"
        data-revision="{{view.context.revision}}" data-word-id="{{item.wordId}}"
        bindtap="choose" bindanimationend="attackFinished">
        <image src="{{item.imagePath}}" mode="aspectFit" aria-hidden="true"
          data-session-id="{{view.context.sessionId}}" data-round-id="{{view.context.roundId}}"
          data-revision="{{view.context.revision}}" data-word-id="{{item.wordId}}"
          bindload="imageLoaded" binderror="imageFailed" />
        <view wx:if="{{item.attacked}}" class="impact" aria-hidden="true">✦</view>
      </button>
    </view>
    <view class="reveal">{{view.teachingWord || view.revealedWord}}</view>
    <view class="hero" aria-label="小岛守护者"><view class="eyes">● ●</view><view class="weapon"></view></view>
  </view>
  <button wx:if="{{view.status === 'audioError'}}" class="primary-button" bindtap="retryAudio"
    data-session-id="{{view.context.sessionId}}" data-round-id="{{view.context.roundId}}"
    data-revision="{{view.context.revision}}">重新播放</button>
  <button wx:elif="{{view.status !== 'completed'}}" class="primary-button" disabled="{{!view.canReplay}}" bindtap="replay"
    data-session-id="{{view.context.sessionId}}" data-round-id="{{view.context.roundId}}"
    data-revision="{{view.context.revision}}">再听一次</button>
</view>
