.battle { display: flex; flex-direction: column; text-align: center; }
.phase { font-size: 34rpx; font-weight: 700; }
.phase-progress { font-size: 26rpx; color: #587166; margin-top: 8rpx; }
.phase-instruction { font-size: 26rpx; line-height: 1.5; margin-top: 16rpx; color: #587166; }
.shield-panel { margin-top: 20rpx; }
.shield-row { display: flex; justify-content: center; gap: 18rpx; }
.shield { box-sizing: border-box; width: 44rpx; height: 48rpx; border: 4rpx solid #246b51; border-radius: 12rpx 12rpx 24rpx 24rpx; }
.shield.intact { background: #91cfa3; }
.shield.removed { border-style: dashed; border-color: #a3b7a5; background: transparent; }
.shield-caption { font-size: 24rpx; color: #587166; margin-top: 8rpx; }
.status { margin: 20rpx 0; min-height: 80rpx; font-size: 30rpx; line-height: 1.4; }
.arena { flex: 1; min-height: 520rpx; position: relative; border-radius: 48rpx; background: #edf3dd; margin: 12rpx 0 32rpx; padding: 28rpx 12rpx 180rpx; }
.targets { display: flex; justify-content: center; gap: 12rpx; min-height: 200rpx; align-items: center; }
.target { box-sizing: border-box; padding: 8rpx; margin: 0; width: 190rpx; height: 190rpx; background: #fff; border: 6rpx solid transparent; border-radius: 36rpx; position: relative; }
.target::after { border: none; }
.target[disabled] { background: #fff; opacity: 1; }
.target image { width: 100%; height: 100%; }
.target.hinted { border-color: #e3aa31; box-shadow: 0 0 0 6rpx #fff2bf; }
.target.attacked { animation: target-hit 650ms ease-in-out forwards; }
.impact { position: absolute; inset: 0; font-size: 110rpx; line-height: 180rpx; color: #e3aa31; pointer-events: none; }
.reveal { font-size: 42rpx; font-weight: 700; min-height: 64rpx; margin-top: 24rpx; }
.hero { position: absolute; width: 110rpx; height: 100rpx; border-radius: 40rpx 40rpx 24rpx 24rpx; background: #91cfa3; border: 5rpx solid #246b51; bottom: 32rpx; left: calc(50% - 60rpx); }
.eyes { font-size: 26rpx; padding-top: 24rpx; letter-spacing: 8rpx; }
.weapon { position: absolute; width: 26rpx; height: 48rpx; background: #e3aa31; border: 4rpx solid #896727; border-radius: 14rpx; right: -20rpx; top: -14rpx; transform: rotate(20deg); }
@keyframes target-hit { 0% { transform: scale(1); } 35% { transform: scale(1.08) rotate(-5deg); } 65% { transform: scale(.9) rotate(5deg); } 100% { transform: scale(.65); opacity: 0; } }

.preview-page { padding: 24rpx 28rpx 40rpx; background: #f5f0df; }
.preview-kicker { color: #8c6124; font-size: 23rpx; letter-spacing: 2rpx; }
.preview-title { color: #183f42; font-size: 42rpx; font-weight: 700; margin: 8rpx 0; }
.preview-note { color: #647974; font-size: 24rpx; margin-bottom: 20rpx; line-height: 1.5; }
.preview-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.preview-actions button { flex: 1; background: #246858; color: #fff; font-size: 26rpx; }
