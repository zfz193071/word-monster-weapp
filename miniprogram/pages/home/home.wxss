.cloud::after { width: 48rpx; height: 44rpx; right: 20rpx; bottom: 5rpx; }
.cloud-one { top: 15%; animation-delay: -31s; }.cloud-two { top: 23%; width: 200rpx; opacity: .45; animation-duration: 85s; animation-delay: -49s; animation-direction: alternate-reverse; }
.sky-paused .cloud { animation-play-state: paused; }
.upper-cloud { position: absolute; left: 0; width: 150rpx; height: 32rpx; pointer-events: none; animation: cloud-drift 80s linear infinite alternate; }
.upper-cloud .cloud { animation: none; transform-origin: left center; opacity: .5; }
