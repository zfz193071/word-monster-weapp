/* Image-led companion studio. Scroll remains usable on short landscape screens. */
.pet-modal { position:relative; box-sizing:border-box; width:100%; max-width:660rpx; padding:26rpx; border:4rpx solid #fffaf0; border-radius:38rpx; background:linear-gradient(160deg,#f6fcfa,#fff6e7); color:#3e6170; box-shadow:0 24rpx 80rpx #203f4b35; }
.pet-heading { display:flex; align-items:center; gap:20rpx; padding-right:60rpx; }
