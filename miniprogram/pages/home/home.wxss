.pet-hero { position:absolute; width:360rpx; height:360rpx; left:50%; bottom:0; margin-left:-180rpx; transform-origin:50% 85%; }.pet-age-baby { transform:scale(.8); }.pet-age-young { transform:scale(.9); }
.pet-level { position:absolute; bottom:8rpx; left:50%; transform:translateX(-50%); padding:8rpx 22rpx; border:3rpx solid #fff; border-radius:26rpx; background:#537d91; color:#fff; font-size:28rpx; font-weight:bold; box-shadow:0 5rpx 12rpx #42677d22; white-space:nowrap; }.pet-level text { font-size:20rpx; margin-left:12rpx; font-weight:normal; color:#e2f4ef; }
.pet-spark { position:absolute; color:#e3bb62; font-size:38rpx; }.pet-spark-one { left:15%; top:22%; }.pet-spark-two { right:12%; top:46%; }.pet-spark-three { left:23%; bottom:16%; font-size:22rpx; }
.pet-progress { height:10rpx; margin:18rpx 48rpx 0; border-radius:10rpx; overflow:hidden; background:#dce8e5; }.pet-progress view { height:100%; border-radius:10rpx; background:linear-gradient(90deg,#82b9bd,#99d3ba); transition:width .3s; }
.pet-caption { display:block; text-align:center; margin:8rpx 0 12rpx; color:#758f93; font-size:20rpx; }
.pet-actions { display:flex; gap:14rpx; margin-top:14rpx; }.pet-actions button { display:flex; flex:1; flex-direction:column; align-items:center; margin:0; padding:10rpx 4rpx 14rpx; line-height:1.4; background:#e9f0e6; border-radius:24rpx; color:#446b61; font-size:24rpx; }.pet-actions image { width:74rpx; height:66rpx; }.pet-actions .pet-upgrade { background:#f7deb0; color:#785b30; }.pet-action-count { font-size:21rpx; opacity:.75; }.pet-actions button[disabled] { opacity:.5; }
.pet-section-row { display:flex; align-items:center; justify-content:space-between; }.pet-section { display:block; margin:24rpx 0 12rpx; font-size:24rpx; font-weight:bold; }.pet-stones { display:flex; align-items:center; font-size:20rpx; }.pet-stones image { width:38rpx; height:38rpx; }
.pet-skill { display:flex; align-items:center; gap:22rpx; margin:0; padding:12rpx; border-radius:26rpx; background:linear-gradient(115deg,#e4edf8,#eeeafa); text-align:left; line-height:1.4; color:#425c7d; }.pet-skill>image { width:138rpx; height:138rpx; flex-shrink:0; }.pet-skill-info text { display:block; }.pet-skill-name { font-size:28rpx; font-weight:bold; }.pet-skill-stats { margin:10rpx 0; font-size:23rpx; }.pet-skill-hint { font-size:20rpx; color:#7c8da4; }.pet-details { margin-top:12rpx; padding:18rpx; font-size:23rpx; line-height:1.7; background:#ffffff88; border-radius:18rpx; }.pet-details text { display:block; margin-top:10rpx; }
.pet-gear-grid { display:flex; gap:12rpx; }.pet-gear { flex:1; min-width:0; margin:0; padding:12rpx 4rpx; border:2rpx solid transparent; border-radius:22rpx; background:#f1eddf; color:#6c786e; line-height:1.5; font-size:20rpx; }.pet-gear image { display:block; width:90rpx; height:80rpx; margin:auto; }.pet-gear text { display:block; }.pet-gear .pet-gear-status { font-size:18rpx; opacity:.75; }.pet-gear[disabled] { opacity:.48; }.pet-gear-equipped { border-color:#89b7a2; background:#e6f3e8; }.pet-gear::after,.pet-actions button::after,.pet-skill::after { border:0; }
