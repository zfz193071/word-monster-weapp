.home { display: flex; flex-direction: column; align-items: center; text-align: center; }
.island-badge { padding: 12rpx 28rpx; border-radius: 40rpx; background: #f5e4ae; font-size: 26rpx; margin-bottom: 28rpx; }
.hero { height: 330rpx; width: 100%; position: relative; display: flex; align-items: center; justify-content: center; }
.monster-shape { position: relative; z-index: 1; width: 210rpx; height: 200rpx; border-radius: 85rpx 85rpx 66rpx 66rpx; background: #a2d69a; transform: rotate(-6deg); border: 6rpx solid #6ead75; }
.eyes { display: flex; justify-content: center; gap: 36rpx; padding-top: 54rpx; }
.eyes view { width: 28rpx; height: 38rpx; border-radius: 50%; background: #25483d; border: 10rpx solid #fff; }
.smile { width: 46rpx; height: 20rpx; border-bottom: 6rpx solid #25483d; border-radius: 50%; margin: 10rpx auto; }
.ground { position: absolute; width: 300rpx; height: 46rpx; border-radius: 50%; background: #eadfbf; bottom: 43rpx; }
.description { margin-bottom: 44rpx; }
