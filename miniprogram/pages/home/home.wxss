.pet-celebrating .pet-hero { animation:pet-cheer .8s ease-in-out; }.pet-celebrating .pet-halo { animation:pet-glow 1.6s ease-out; }.pet-celebrating .pet-spark { animation:pet-sparkle .8s ease-in-out 2; }
