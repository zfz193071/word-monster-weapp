<view class="home">
  <view class="sky-streak streak-one"></view><view class="sky-streak streak-two"></view>
  <view class="cloud cloud-one"></view><view class="cloud cloud-two"></view>
  <button class="info-button" bindtap="toggleCredits" aria-label="素材署名">i</button>
  <button class="music-button {{!musicEnabled || musicStatus === 'error' ? 'muted' : ''}}" bindtap="toggleMusic" aria-label="{{musicStatus === 'error' ? '重试场景音乐' : musicEnabled ? '关闭场景音乐' : '开启场景音乐'}}"><view class="music-note">♪</view><view wx:if="{{!musicEnabled || musicStatus === 'error'}}" class="mute-slash"></view></button>
  <view class="island" aria-hidden="true">
    <home-scene class="home-room" paused="{{!homeVisible}}" covered="{{!!request || showCredits}}" />
  </view>
  <view class="start-dock">
    <button class="start-button" bindtap="openBattle" disabled="{{!!request}}" aria-label="开始闯关"><view class="play-icon"></view></button>
    <view class="dock-dot"></view>
  </view>
  <view wx:if="{{request}}" class="modal-backdrop" catchtouchmove="stopScroll">
    <view class="choice-modal" role="dialog" aria-label="听音选水果">
      <button class="close-button" bindtap="closeChallenge" disabled="{{opening}}" aria-label="关闭">×</button>
      <fortress-choice class="fruit-dialog-choice" wx:if="{{!choiceComplete}}" request="{{request}}" bindstartcombat="choiceSucceeded" />
      <view wx:else class="entry-status">
        <view class="success-mark">✓</view>
        <view wx:if="{{navigationError}}">暂时没能进入战场</view>
        <button wx:if="{{navigationError}}" class="retry-entry" bindtap="enterBattle">重试</button>
        <view wx:else>正在出发…</view>
      </view>
    </view>
  </view>
  <view wx:if="{{showCredits}}" class="modal-backdrop" catchtouchmove="stopScroll">
    <view class="credits-modal"><button class="close-button" bindtap="toggleCredits" aria-label="关闭">×</button>
      <scroll-view scroll-y class="credits-scroll"><view class="credits-title">素材署名</view><view class="credit">房间与守卫：本项目原创三维几何场景。
场景音乐《小屋清晨》、战斗循环音乐与命中音效：本项目原创旋律与合成音色。</view>
        <view wx:for="{{credits}}" wx:key="path" class="credit"><view>{{item.wordId}} · {{item.kind === 'image' ? '图片' : '发音'}}</view><text user-select="true">{{item.rights}}\n{{item.source}}</text></view>
      </scroll-view>
    </view>
  </view>
</view>
