{
  "name": "word-monster-weapp",
  "version": "0.1.0",
  "private": true,
  "description": "单词小卫士：听音识词与堡垒闯关微信小程序",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "release:upload": "node scripts/release-upload.mjs",
    "release:check": "node scripts/release-upload.mjs --check-only",
    "typecheck": "tsc --noEmit",
    "check:project": "node scripts/check-project.mjs",
    "check": "npm run typecheck && npm run check:project && npm run check:content && npm run check:fortress",
    "test": "tsx --test tests/*.test.ts",
    "check:content": "node --import tsx scripts/check-content.ts",
    "check:assets": "node --import tsx scripts/check-content.ts --assets",
    "check:fortress": "node --import tsx scripts/check-fortress.ts",
    "check:fortress:assets": "node --import tsx scripts/check-fortress.ts --assets"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "miniprogram-api-typings": "5.2.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
