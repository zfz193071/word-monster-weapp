{
  "name": "word-monster-weapp",
  "version": "0.1.0",
  "private": true,
  "description": "单词怪物原生微信小程序",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:project": "node scripts/check-project.mjs",
    "check": "npm run typecheck && npm run check:project && npm run check:content",
    "test": "tsx --test tests/*.test.ts",
    "check:content": "node --import tsx scripts/check-content.ts",
    "check:assets": "node --import tsx scripts/check-content.ts --assets"
  },
  "devDependencies": {
    "miniprogram-api-typings": "5.2.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
